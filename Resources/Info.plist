	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.example.mycallrec.url</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mycallrec</string>
			</array>
		</dict>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>录制通话与环境音</string>
